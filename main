const { ethers } = require("hardhat");
async function main() {
console.log("Starting deployment on Base network...");
const Token = await ethers.getContractFactory("BaseBuilderToken");
const token = await Token.deploy();
await token.waitForDeployment();
const tokenAddress = await token.getAddress();
console.log(`BaseBuilderToken deployed to: ${tokenAddress}`);
}
main()
Invoke main deployment function
.catch((error) => {
console.error(error);
